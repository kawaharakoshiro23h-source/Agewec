# このファイルをコピーして .env を作り、実際のキーを入れる:
#   cp .env.example .env
# .env は .gitignore で除外済み（コミットされない）。

# --- ローカルLLM: LM Studio（OpenAI互換サーバ）---
# LM Studio は base_url を差すだけ。キーはダミーでよい場合が多い
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio

# --- ローカルサービスのエンドポイント ---
COMFYUI_URL=http://localhost:8188
VOICEVOX_URL=http://localhost:50021

# --- クラウド動画（フォールバック・使う場合のみ）---
KLING_API_KEY=
RUNWAY_API_KEY=
GOOGLE_API_KEY=
