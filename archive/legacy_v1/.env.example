# このファイルをコピーして .env を作り、実際のキーを入れる:
#   cp .env.example .env
# .env は .gitignore で除外済み（コミットされない）。

# --- ローカルLLM: LM Studio（OpenAI互換サーバ）---
# base_url を差すだけ。キーは本物不要（ダミー文字列でよい）
LOCAL_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_API_KEY=lm-studio
LLM_MODEL=local-model   # LM Studioで読み込み中のモデルID（画面に表示される名前）に置き換える

# --- ローカルサービスのエンドポイント ---
COMFYUI_URL=http://localhost:8188
VOICEVOX_URL=http://localhost:50021

# --- クラウド動画（フォールバック・使う場合のみ）---
KLING_API_KEY=
RUNWAY_API_KEY=
GOOGLE_API_KEY=
